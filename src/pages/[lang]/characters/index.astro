---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { languages, getLanguage, useTranslations, localePath } from '../../../lib/i18n';
import { resolveProse } from '../../../lib/content';
import Emblem from '../../../components/Emblem.astro';
import { liveryStyle, franchiseName, universeOf } from '../../../lib/livery';
import { searchable } from '../../../lib/search-text';

export function getStaticPaths() {
  return languages.map((language) => ({ params: { lang: language.code } }));
}

const { lang } = Astro.params;
const language = getLanguage(lang!);
const t = useTranslations(language.code);

const titles = await getCollection('titles');
const sagaOf = new Map(titles.map((title) => [title.data.id, title.data.saga]));

type Listed = {
  id: string;
  sigil: string | null;
  name: string;
  alias: string | null;
  line: string;
  actors: string;
  franchise: string;
  saga: string;
  universe: { designation: string };
  appearances: number;
  alignment: string;
  haystack: string;
};

const people: Listed[] = [];
for (const person of await getCollection('characters')) {
  const prose = await resolveProse('characterProse', language.code, person.data.id);
  if (!prose) continue;
  const actors = person.data.actors.map((actor) => actor.name).join(', ');
  people.push({
    id: person.data.id,
    sigil: person.data.sigil,
    name: prose.entry.data.title,
    /* The name people use and the name they are known by are both the
       answer to "who is this", so the card carries both. */
    alias: prose.entry.data.tagline ?? null,
    line: prose.entry.data.oneLine,
    actors,
    franchise: person.data.franchise,
    saga: sagaOf.get(person.data.firstAppearance) ?? 'unbound',
    universe: universeOf(person.data.universe),
    appearances: person.data.appearsIn.length,
    alignment: person.data.alignment,
    haystack: searchable(
      `${prose.entry.data.title} ${prose.entry.data.tagline ?? ''} ${person.data.realName ?? ''} ${actors} ${franchiseName(person.data.franchise)}`,
    ),
  });
}

/* Only the groups that actually have somebody in them get a button. */
const ALIGNMENTS = ['hero', 'antihero', 'villain', 'mentor', 'supporting'].filter((value) =>
  people.some((person) => person.alignment === value),
);

const collator = new Intl.Collator(language.code);
people.sort((a, b) => collator.compare(a.name, b.name));
---

<Base
  language={language.code}
  title={`${t('characters.title')}. Phase Zero`}
  description={t('characters.lede')}
  path="characters"
  editPath={`content/${language.code}/characters/`}
>
  <section class="bleed band" data-livery style="--livery-base: var(--livery-sony); --shade: 0">
    <div class="page">
      <div class="plate">
        <h1 class="plate-title">{t('characters.title')}</h1>
        <p class="plate-meta">{t('characters.lede')}</p>
      </div>
    </div>
  </section>

  <div class="page section">
    <div class="search-field">
      <input
        type="search"
        data-search-input
        placeholder={t('characters.searchPlaceholder')}
        aria-label={t('characters.searchPlaceholder')}
        aria-controls="results"
        autocomplete="off"
      />
      <button type="button" data-search-clear hidden>{t('search.clear')}</button>
    </div>

    {/* Filtering by what somebody is, which the search box cannot do because
        the classification is not a word on the page. Rendered as links so it
        works with no JavaScript: each one is the same list, pre-filtered. */}
    <fieldset class="control">
      <legend class="label">{t('characters.alignment')}</legend>
      <div class="switch">
        <button type="button" data-alignment="all" aria-pressed="true">
          {t('characters.alignment.all')}
        </button>
        {ALIGNMENTS.map((value) => (
          <button type="button" data-alignment={value} aria-pressed="false">
            {t(`characters.alignment.${value}`)}
          </button>
        ))}
      </div>
    </fieldset>

    <p
      class="tally"
      data-search-tally
      aria-live="polite"
      data-showing={t('characters.showing', { count: '{count}', total: '{total}' })}
    >{t('characters.showing', { count: people.length, total: people.length })}</p>

    <ul class="people" id="results" data-results>
      {people.map((person) => (
        <li
          class="person"
          data-haystack={person.haystack}
          data-alignment={person.alignment}
          data-livery
          style={liveryStyle(person.saga, person.franchise)}
        >
          <a href={localePath(language.code, 'characters', person.id)}>
            <div class="person-head">
              <Emblem id={person.id} sigil={person.sigil} saga={person.saga} franchise={person.franchise} size={64} />
              <div>
                <h2 class="person-name">{person.name}</h2>
                {person.alias && <p class="person-alias">{person.alias}</p>}
              </div>
            </div>
            <p class="person-line">{person.line}</p>
            <p class="person-meta">
              {person.actors && <span>{t('characters.playedBy')} {person.actors}</span>}
              <span class="figure">{t('characters.appearsInCount', { count: person.appearances })}</span>
            </p>
          </a>
        </li>
      ))}
    </ul>

    <p class="empty-state" data-search-empty hidden>{t('search.empty')}</p>
  </div>

  <script>
    import '../../../scripts/search';
  </script>
</Base>
