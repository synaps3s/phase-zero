---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import FallbackNotice from '../../../components/FallbackNotice.astro';
import Emblem from '../../../components/Emblem.astro';
import { languages, getLanguage, useTranslations, localePath } from '../../../lib/i18n';
import { resolveProse, sourceSlugs } from '../../../lib/content';
import { liveryStyle, franchiseName, universeOf, designationOf } from '../../../lib/livery';

export async function getStaticPaths() {
  // See the note on the title route: no prose, no page, and no broken build.
  const written = new Set(await sourceSlugs('characterProse'));
  const people = (await getCollection('characters')).filter((entry) => written.has(entry.data.id));
  return languages.flatMap((language) =>
    people.map((person) => ({
      params: { lang: language.code, id: person.data.id },
      props: { personId: person.data.id },
    })),
  );
}

const { lang } = Astro.params;
const { personId } = Astro.props;
const language = getLanguage(lang!);
const t = useTranslations(language.code);

const person = (await getCollection('characters')).find((entry) => entry.data.id === personId)!;
const prose = await resolveProse('characterProse', language.code, personId);
if (!prose) return Astro.rewrite('/404');

const { Content } = await render(prose.entry);

const titles = await getCollection('titles');
const byId = new Map(titles.map((title) => [title.data.id, title]));
const saga = byId.get(person.data.firstAppearance)?.data.saga ?? 'unbound';

const appearances = [];
for (const id of person.data.appearsIn) {
  const title = byId.get(id);
  if (!title) continue;
  const titleProse = await resolveProse('titleProse', language.code, id);
  appearances.push({
    id,
    label: titleProse?.entry.data.title ?? id,
    year: title.data.release.date ? String(title.data.release.date.getUTCFullYear()) : '',
    saga: title.data.saga,
    franchise: title.data.franchise,
  });
}

/* The journey is ordered by the catalogue rather than by how it was written,
   so it always reads in release order even if an entry is added out of turn. */
const journey = [];
for (const step of prose.entry.data.journey) {
  const title = byId.get(step.title);
  if (!title) continue;
  const titleProse = await resolveProse('titleProse', language.code, step.title);
  journey.push({
    id: step.title,
    text: step.text,
    label: titleProse?.entry.data.title ?? step.title,
    year: title.data.release.date ? String(title.data.release.date.getUTCFullYear()) : '',
    saga: title.data.saga,
    franchise: title.data.franchise,
    order: Number(title.data.release.date ?? 0),
  });
}
journey.sort((a, b) => a.order - b.order);

/* Both names in one string: the person and the name they are known by. A
   reader searching for either should land on the same page. */
const fullName = prose.entry.data.tagline
  ? `${prose.entry.data.title}, ${prose.entry.data.tagline}`
  : prose.entry.data.title;

/* The plate is meant to be the same object on every character page, and a
   name of four letters next to a name of thirty-four was making it two
   different shapes. The heading takes a size step down as the name grows so
   it wraps to two lines at most, which keeps the plate close to the height
   of the emblem standing beside it.

   Measured on the rendered name rather than on the id, because a translated
   name is not the same length as the English one. */
const nameLength = prose.entry.data.title.length;
const nameSize = nameLength > 26 ? 'long' : nameLength > 18 ? 'medium' : 'short';

const universe = universeOf(person.data.universe);
/* Their own Earth when the films name one; the universe's otherwise, even in
   the shared story, since on their own page there is room to say it. */
const designation = person.data.designation ?? universe.designation;
const verified = new Intl.DateTimeFormat(language.code, { dateStyle: 'medium', timeZone: 'UTC' }).format(
  person.data.verified,
);
---

<Base
  language={language.code}
  title={`${fullName}. Phase Zero`}
  description={prose.entry.data.oneLine}
  path={`characters/${personId}`}
  editPath={`content/${language.code}/characters/${personId}.md`}
>
  <section class="bleed band" data-livery style={liveryStyle(saga, person.data.franchise)}>
    <div class="page">
      <div class="plate">
        <a class="crumb" href={localePath(language.code, 'characters')}>{t('characters.title')}</a>
        <div class="entry-emblem">
          <Emblem
            id={personId}
            sigil={person.data.sigil}
            saga={saga}
            franchise={person.data.franchise}
            size={112}
            label={prose.entry.data.title}
          />
          <div>
            <h1 class="plate-title" data-length={nameSize}>{prose.entry.data.title}</h1>
            {prose.entry.data.tagline && (
              <p class="plate-alias">{prose.entry.data.tagline}</p>
            )}
          </div>
        </div>
        <p class="plate-meta">
          {person.data.realName && <span>{person.data.realName}</span>}
          {/* The franchise is dropped when it repeats the alias already in
              the heading, which it does for anyone who gave a franchise its
              name. */}
          {franchiseName(person.data.franchise) !== prose.entry.data.tagline && (
            <span>{franchiseName(person.data.franchise)}</span>
          )}
          <span>{designation}</span>
        </p>
      </div>
    </div>
  </section>

  <div class="page">
    {prose.isFallback && (
      <FallbackNotice
        language={language.code}
        shownLanguage={prose.language}
        editPath={`content/${language.code}/characters/${personId}.md`}
      />
    )}

    <article class="entry-body prose">
      <p class="entry-lede">{prose.entry.data.oneLine}</p>
      <Content />
    </article>

    <dl class="facts">
      {person.data.actors.length > 0 && (
        <div>
          <dt class="label">{t('characters.playedBy')}</dt>
          <dd>{person.data.actors.map((actor) => actor.name).join(', ')}</dd>
        </div>
      )}
      {prose.entry.data.role && (
        <div><dt class="label">{t('character.role')}</dt><dd>{prose.entry.data.role}</dd></div>
      )}
      {prose.entry.data.born && (
        <div><dt class="label">{t('character.born')}</dt><dd>{prose.entry.data.born}</dd></div>
      )}
      {prose.entry.data.affiliation && (
        <div><dt class="label">{t('character.affiliation')}</dt><dd>{prose.entry.data.affiliation}</dd></div>
      )}
      {prose.entry.data.powers && (
        <div><dt class="label">{t('character.powers')}</dt><dd>{prose.entry.data.powers}</dd></div>
      )}
    </dl>

    {journey.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>{t('character.journey')}</h2>
          <p>{t('character.journeyLede')}</p>
        </div>
        <ol class="journey">
          {journey.map((step) => (
            <li class="step" data-livery style={liveryStyle(step.saga, step.franchise)}>
              <p class="step-title">
                <a href={localePath(language.code, 'titles', step.id)}>{step.label}</a>
                <span class="step-year figure">{step.year}</span>
              </p>
              <p class="step-text">{step.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {appearances.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t('character.appearsIn')}</h2></div>
        <ol class="saga-run">
          {appearances.map((entry) => (
            <li class="chip" data-livery style={liveryStyle(entry.saga, entry.franchise)}>
              <a href={localePath(language.code, 'titles', entry.id)}>
                <span class="chip-title">{entry.label}</span>
                <span class="chip-year figure">{entry.year}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="sources">
      <h2 class="label">{t('common.sources')}</h2>
      <ul>
        {person.data.sources.map((source) => (
          <li><a href={source.url}>{source.title ?? source.url}</a></li>
        ))}
      </ul>
      <p style="margin-top: var(--s3)">{t('common.verifiedOn', { date: verified })}</p>
    </section>
  </div>
</Base>
