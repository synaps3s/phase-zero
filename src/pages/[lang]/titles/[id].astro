---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import FallbackNotice from '../../../components/FallbackNotice.astro';
import { formatWindow, languages, getLanguage, useTranslations, localePath } from '../../../lib/i18n';
import { resolveProse, sourceSlugs } from '../../../lib/content';
import { liveryStyle, universeOf, franchiseName } from '../../../lib/livery';
import { leadsToMap } from '../../../lib/connections';

export async function getStaticPaths() {
  /* A page exists when there is prose in the source language to put on it.
     Facts without prose are an error the fact check reports by name; they
     must not also take the build down with an unroutable path. */
  const written = new Set(await sourceSlugs('titleProse'));
  const titles = (await getCollection('titles')).filter((entry) => written.has(entry.data.id));
  return languages.flatMap((language) =>
    titles.map((entry) => ({
      params: { lang: language.code, id: entry.data.id },
      props: { titleId: entry.data.id },
    })),
  );
}

const { lang } = Astro.params;
const { titleId } = Astro.props;
const language = getLanguage(lang!);
const t = useTranslations(language.code);

const facts = (await getCollection('titles')).find((entry) => entry.data.id === titleId)!;
const prose = await resolveProse('titleProse', language.code, titleId);
if (!prose) return Astro.rewrite('/404');

const { Content } = await render(prose.entry);

/* The connections are already in the data and were only ever visible on the
   map. On the entry itself they answer the two questions a reader actually
   has in front of a film: what do I need first, and what does this open. */
const allTitles = await getCollection('titles');
const byId = new Map(allTitles.map((entry) => [entry.data.id, entry]));

async function linksFor(ids: string[]) {
  const out = [];
  for (const id of ids) {
    const entry = byId.get(id);
    if (!entry) continue;
    const linkProse = await resolveProse('titleProse', language.code, id);
    out.push({
      id,
      label: linkProse?.entry.data.title ?? id,
      year: entry.data.release.date ? String(entry.data.release.date.getUTCFullYear()) : '',
      saga: entry.data.saga,
      franchise: entry.data.franchise,
    });
  }
  return out;
}

const requires = await linksFor(facts.data.requires);
/* Read backwards out of every other entry's prerequisites, so this list and
   those can never disagree. */
const leadsTo = await linksFor(leadsToMap(allTitles).get(titleId) ?? []);

/* Who is in this, derived rather than stored. A character already lists the
   titles it appears in, so asking the question the other way round needs no
   second copy of the answer and cannot drift out of step with the first. */
const people = [];
for (const person of await getCollection('characters')) {
  if (!person.data.appearsIn.includes(titleId)) continue;
  const personProse = await resolveProse('characterProse', language.code, person.data.id);
  if (!personProse) continue;
  const firstTitle = byId.get(person.data.firstAppearance);
  people.push({
    id: person.data.id,
    name: personProse.entry.data.title,
    alias: personProse.entry.data.tagline ?? null,
    actors: person.data.actors.map((actor) => actor.name).join(', '),
    saga: firstTitle?.data.saga ?? 'unbound',
    franchise: person.data.franchise,
    /* The order a reader expects is the one the catalogue already sorts
       people by, which is by name in their own language. */
    sort: personProse.entry.data.title,
  });
}
const collator = new Intl.Collator(language.code);
people.sort((first, second) => collator.compare(first.sort, second.sort));

const universe = universeOf(facts.data.universe);
const release = facts.data.release;
/* The year when there is one, and the announced window when there is not. */
const year = release.date
  ? String(release.date.getUTCFullYear())
  : release.approximate
    ? formatWindow(language.code, release.approximate)
    : '';
const unreleased = release.status !== 'released';
const dateFormatter = new Intl.DateTimeFormat(language.code, { dateStyle: 'long', timeZone: 'UTC' });
const verified = new Intl.DateTimeFormat(language.code, { dateStyle: 'medium', timeZone: 'UTC' }).format(
  facts.data.verified,
);
---

<Base
  language={language.code}
  title={`${prose.entry.data.title}. Phase Zero`}
  description={prose.entry.data.oneLine}
  path={`titles/${titleId}`}
  editPath={`content/${language.code}/titles/${titleId}.md`}
>
  <section class="bleed band" data-livery style={liveryStyle(facts.data.saga, facts.data.franchise)}>
    <div class="page">
      <div class="plate">
        <a class="crumb" href={localePath(language.code)}>{t('nav.home')}</a>
        <h1 class="plate-title">{prose.entry.data.title}</h1>
        <p class="plate-meta">
          <span class="figure">{year}</span>
          {unreleased && (
            <span class="plate-upcoming">
              {t(release.status === 'announced' ? 'title.status.announced' : 'title.status.inProduction')}
            </span>
          )}
          <span class="plate-kind">{t(`title.kind.${facts.data.type}`)}</span>
          {release.episodes && (
            <span class="figure">{t('title.episodes', { count: release.episodes })}</span>
          )}
          {release.runtime && (
            <span class="figure">
              {t(release.episodes ? 'title.runtimeEach' : 'title.runtime', { minutes: release.runtime })}
            </span>
          )}
          {facts.data.phase !== null && <span>{t('title.phase', { number: facts.data.phase })}</span>}
          <span>{franchiseName(facts.data.franchise)}</span>
          <span>{universe.designation}</span>
        </p>
      </div>
    </div>
  </section>

  <div class="page">
    {prose.isFallback && (
      <FallbackNotice
        language={language.code}
        shownLanguage={prose.language}
        editPath={`content/${language.code}/titles/${titleId}.md`}
      />
    )}

    <article class="entry-body prose">
      <p class="entry-lede">{prose.entry.data.oneLine}</p>
      <Content />

      {people.length > 0 && (
        <section class="connections">
          <h2 class="label">{t('title.whoIsIn')}</h2>
          <ul class="title-cast">
            {people.map((person) => (
              <li class="chip" data-livery style={liveryStyle(person.saga, person.franchise)}>
                <a href={localePath(language.code, 'characters', person.id)}>
                  <span class="chip-title">{person.name}</span>
                  {person.alias && <span class="chip-alias">{person.alias}</span>}
                  {person.actors && <span class="chip-year">{person.actors}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(requires.length > 0 || leadsTo.length > 0) && (
        <section class="connections">
          <h2 class="label">{t('title.connections')}</h2>

          {requires.length > 0 && (
            <div class="connection">
              <p class="connection-lede">{t('title.requiresHelp')}</p>
              <ol class="saga-run">
                {requires.map((link) => (
                  <li class="chip" data-livery style={liveryStyle(link.saga, link.franchise)}>
                    <a href={localePath(language.code, 'titles', link.id)}>
                      <span class="chip-title">{link.label}</span>
                      <span class="chip-year figure">{link.year}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {leadsTo.length > 0 && (
            <div class="connection">
              <p class="connection-lede">{t('title.leadsToHelp')}</p>
              <ol class="saga-run">
                {leadsTo.map((link) => (
                  <li class="chip" data-livery style={liveryStyle(link.saga, link.franchise)}>
                    <a href={localePath(language.code, 'titles', link.id)}>
                      <span class="chip-title">{link.label}</span>
                      <span class="chip-year figure">{link.year}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </section>
      )}

      <section class="sources">
        <h2 class="label">{t('common.sources')}</h2>
        <ul>
          {facts.data.sources.map((source) => (
            <li><a href={source.url}>{source.title ?? source.url}</a></li>
          ))}
        </ul>
        <p style="margin-top: var(--s3)">{t('common.verifiedOn', { date: verified })}</p>
        {release.date && (
          <p style="margin-top: var(--s2)">
            {t('title.released')}: <span class="figure">{dateFormatter.format(release.date)}</span>
          </p>
        )}
        {!release.date && release.approximate && (
          <p style="margin-top: var(--s2)">
            {t('title.released')}: <span class="figure">{formatWindow(language.code, release.approximate)}</span>
          </p>
        )}
      </section>
    </article>
  </div>
</Base>
