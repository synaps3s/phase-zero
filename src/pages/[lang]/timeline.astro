---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Spine from '../../components/Spine.astro';
import ConnectionMap from '../../components/ConnectionMap.astro';
import { languages, getLanguage, useTranslations, localePath } from '../../lib/i18n';
import { resolveProse } from '../../lib/content';
import { franchiseName, universeOf } from '../../lib/livery';

export function getStaticPaths() {
  return languages.map((language) => ({ params: { lang: language.code } }));
}

const { lang } = Astro.params;
const language = getLanguage(lang!);
const t = useTranslations(language.code);

const TIER_RANK: Record<string, number> = { essential: 1, extended: 2, complete: 3 };

/* Every title is rendered, in release order, and the browser reorders and
   filters what is already here. With no JavaScript the page is still the
   complete catalogue in a sensible order, which is the point. */
/* A title with no date at all is announced for a window rather than a day.
   It belongs at the end of a release-ordered list, not at the start, which is
   where a null would otherwise put it. */
const UNDATED = Number.MAX_SAFE_INTEGER;
const releaseKey = (date: Date | null) => (date ? Number(date) : UNDATED);
const titles = (await getCollection('titles')).sort(
  (a, b) => releaseKey(a.data.release.date) - releaseKey(b.data.release.date),
);

const rows = [];
for (const [index, entry] of titles.entries()) {
  const prose = await resolveProse('titleProse', language.code, entry.data.id);
  if (!prose) continue;

  const title = prose.entry.data.title;
  rows.push({
    facts: entry,
    title,
    releaseOrder: index + 1,
    search: [title, t(`saga.${entry.data.saga}`), franchiseName(entry.data.franchise)]
      .join(' ')
      .toLowerCase(),
  });
}

const year = (date: Date | null) => (date ? String(date.getUTCFullYear()) : '');
/* What goes where the year would be: the year, or the window a source gave. */
const when = (release: { date: Date | null; approximate: string | null }) =>
  year(release.date) || release.approximate || '';

/* The map shows every title, not the filtered set: its job is to show how
   the whole thing connects, which is exactly the question a filter hides. */
const mapTitles = rows
  .filter((row) => row.facts.data.release.date)
  .map((row) => ({
    id: row.facts.data.id,
    title: row.title,
    year: row.facts.data.release.date!.getUTCFullYear(),
    saga: row.facts.data.saga,
    franchise: row.facts.data.franchise,
    continuity: row.facts.data.alternateUniverse
      ? 'alternate'
      : universeOf(row.facts.data.universe).continuity,
    leadsTo: row.facts.data.leadsTo,
  }));
---

<Base
  language={language.code}
  title={`${t('timeline.title')}. Phase Zero`}
  description={t('timeline.lede')}
  path="timeline"
>
  <section class="bleed band" data-livery style="--livery-base: var(--livery-infinity); --shade: 0">
    <div class="page">
      <div class="plate">
        <h1 class="plate-title">{t('timeline.title')}</h1>
        <p class="plate-meta">{t('timeline.lede')}</p>
      </div>
    </div>
  </section>

  <div class="page">
    <div class="controls" data-controls>
      <fieldset class="control">
        <legend class="label">{t('timeline.order')}</legend>
        <div class="switch">
          <button type="button" data-order="release" aria-pressed="true">{t('watchOrder.byRelease')}</button>
          <button type="button" data-order="chrono" aria-pressed="false">{t('watchOrder.byChronology')}</button>
        </div>
        <p
          class="control-help"
          data-order-help
          data-release={t('watchOrder.byReleaseHelp')}
          data-chrono={t('watchOrder.byChronologyHelp')}
        >{t('watchOrder.byReleaseHelp')}</p>
      </fieldset>

      <fieldset class="control">
        <legend class="label">{t('timeline.depth')}</legend>
        <div class="switch">
          <button type="button" data-tier="1" aria-pressed="false">{t('watchOrder.tier.essential')}</button>
          <button type="button" data-tier="2" aria-pressed="true">{t('watchOrder.tier.extended')}</button>
          <button type="button" data-tier="3" aria-pressed="false">{t('watchOrder.tier.complete')}</button>
        </div>
        <p
          class="control-help"
          data-tier-help
          data-d1={t('watchOrder.tier.essentialHelp')}
          data-d2={t('watchOrder.tier.extendedHelp')}
          data-d3={t('watchOrder.tier.completeHelp')}
        >{t('watchOrder.tier.extendedHelp')}</p>
      </fieldset>

      <fieldset class="control">
        <legend class="label">{t('timeline.separate')}</legend>
        <div class="switch">
          <button type="button" data-separate="off" aria-pressed="true">{t('timeline.separateOff')}</button>
          <button type="button" data-separate="on" aria-pressed="false">{t('timeline.separateOn')}</button>
        </div>
        <p class="control-help">{t('timeline.separateHelp')}</p>
      </fieldset>

      <fieldset class="control control-search">
        <legend class="label">{t('common.search')}</legend>
        <input
          type="search"
          data-filter
          placeholder={t('timeline.searchPlaceholder')}
          aria-label={t('timeline.searchPlaceholder')}
          autocomplete="off"
        />
      </fieldset>
    </div>

    <ConnectionMap language={language.code} titles={mapTitles} />

    <p
      class="tally"
      data-tally
      aria-live="polite"
      data-showing={t("timeline.showing", { count: "{count}", total: "{total}" })}
      data-progress-one={t("timeline.progress", { count: 1, done: "{done}", total: "{total}" })}
      data-progress-other={t("timeline.progress", { count: 2, done: "{done}", total: "{total}" })}
      data-remaining={t("timeline.remaining", { hours: "{hours}" })}
      data-remaining-done={t('timeline.remainingDone')}
    >{t('timeline.showing', { count: rows.length, total: rows.length })}</p>

    <ol
      class="shelf"
      data-shelf
      data-timeline
      data-label-mark={t('watched.mark')}
      data-label-unmark={t('watched.unmark')}
    >
      {rows.map((row) => (
        <Spine
          language={language.code}
          id={row.facts.data.id}
          title={row.title}
          saga={row.facts.data.saga}
          franchise={row.facts.data.franchise}
          setNumber={row.releaseOrder}
          year={when(row.facts.data.release)}
          runtime={row.facts.data.release.runtime}
          href={localePath(language.code, 'titles', row.facts.data.id)}
          releaseOrder={row.releaseOrder}
          chronoOrder={row.facts.data.chronology.order ?? 100000 + row.releaseOrder}
          tierRank={TIER_RANK[row.facts.data.tier] ?? 3}
          kind={row.facts.data.type}
          episodes={row.facts.data.release.episodes}
          continuity={
            row.facts.data.alternateUniverse
              ? 'alternate'
              : universeOf(row.facts.data.universe).continuity
          }
          universeLabel={
            row.facts.data.alternateUniverse
              ? universeOf(row.facts.data.universe).designation
              : null
          }
          unreleased={row.facts.data.release.status !== 'released'}
          searchText={row.search}
          setting={row.facts.data.chronology.setting}
        />
      ))}
    </ol>

    <p class="empty-state" data-empty hidden>
      {t('timeline.empty')}
      <button type="button" data-clear-filter class="link-button">{t('timeline.clearFilters')}</button>
    </p>

    <section
      class="progress"
      data-progress
      data-imported={t('watched.imported', { count: '{count}', total: '{total}' })}
      data-imported-none={t('watched.importedNone')}
      data-import-failed={t('watched.importFailed')}
      data-cleared={t('watched.cleared')}
      data-reset-confirm={t('watched.resetConfirm')}
    >
      <h2 class="label">{t('watched.progressTitle')}</h2>
      <p class="storage-note">{t('watched.storageNotice')}</p>
      <p class="storage-note">{t('watched.exportHelp')}</p>

      <div class="progress-actions">
        <button type="button" class="onward-link" data-progress-export>{t('watched.export')}</button>

        <label class="onward-link progress-import">
          <span>{t('watched.import')}</span>
          <input type="file" accept="application/json,.json" data-progress-import />
        </label>

        <button type="button" class="progress-clear" data-progress-clear>{t('watched.reset')}</button>
      </div>

      <p class="progress-status" data-progress-status aria-live="polite"></p>
    </section>
  </div>

  <script>
    import '../../scripts/timeline';
    import '../../scripts/progress';
  </script>
</Base>
