---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import FallbackNotice from '../../../components/FallbackNotice.astro';
import { languages, getLanguage, useTranslations, localePath } from '../../../lib/i18n';
import { resolveProse, sourceSlugs } from '../../../lib/content';

export async function getStaticPaths() {
  const slugs = await sourceSlugs('guides');
  return languages.flatMap((language) =>
    slugs.map((slug) => ({ params: { lang: language.code, slug }, props: { slug } })),
  );
}

const { lang } = Astro.params;
const { slug } = Astro.props;
const language = getLanguage(lang!);
const t = useTranslations(language.code);

const guide = await resolveProse('guides', language.code, slug);
if (!guide) return Astro.rewrite('/404');

const { Content } = await render(guide.entry);
---

<Base
  language={language.code}
  title={`${guide.entry.data.title}. Phase Zero`}
  description={guide.entry.data.oneLine}
  path={`guides/${slug}`}
  editPath={`content/${language.code}/guides/${slug}.md`}
>
  <section class="bleed band" data-livery style="--livery-base: var(--livery-infinity); --shade: 0">
    <div class="page">
      <div class="plate">
        <a class="crumb" href={localePath(language.code)}>{t('nav.home')}</a>
        <h1 class="plate-title">{guide.entry.data.title}</h1>
      </div>
    </div>
  </section>

  <div class="page">
    {guide.isFallback && (
      <FallbackNotice
        language={language.code}
        shownLanguage={guide.language}
        editPath={`content/${language.code}/guides/${slug}.md`}
      />
    )}

    <article class="entry-body prose">
      <p class="entry-lede">{guide.entry.data.oneLine}</p>
      <Content />
    </article>
  </div>
</Base>
