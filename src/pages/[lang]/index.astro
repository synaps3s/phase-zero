---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Spine from '../../components/Spine.astro';
import SagaBlock from '../../components/SagaBlock.astro';
import { languages, getLanguage, useTranslations, localePath } from '../../lib/i18n';
import { resolveProse } from '../../lib/content';
import { liveryStyle, sagas } from '../../lib/livery';
import site from '../../../config/site.json';

export function getStaticPaths() {
  return languages.map((language) => ({ params: { lang: language.code } }));
}

const { lang } = Astro.params;
const language = getLanguage(lang!);
const t = useTranslations(language.code);

/* The watch order is release order, which is what the guide recommends for a
   first run. The entrance is simply the first thing on it. */
const run = (await getCollection('titles'))
  .filter((entry) => entry.data.tier === 'essential' && entry.data.release.status === 'released')
  .sort((a, b) => Number(a.data.release.date) - Number(b.data.release.date));

const shelf = [];
for (const [index, entry] of run.entries()) {
  const prose = await resolveProse('titleProse', language.code, entry.data.id);
  if (prose) shelf.push({ facts: entry, prose, setNumber: index + 1 });
}

/* The shelf is the beginning of the run, not a fixed count, so it stays
   correct as the catalogue fills in. */
const run_start = shelf.slice(0, 8);
const first = shelf[0];

/* Every title, grouped by era. This is where the colour system becomes
   visible as a system rather than as one accent: each era owns a hue, and a
   franchise steps a shade within it. */
const everything = await getCollection('titles');
const bySaga = [];
for (const saga of [...sagas].sort((a, b) => a.order - b.order)) {
  const inSaga = everything
    .filter((entry) => entry.data.saga === saga.id)
    .sort((a, b) => Number(a.data.release.date) - Number(b.data.release.date));
  if (inSaga.length === 0) continue;

  const entries = [];
  for (const entry of inSaga) {
    const prose = await resolveProse('titleProse', language.code, entry.data.id);
    entries.push({
      id: entry.data.id,
      title: prose?.entry.data.title ?? entry.data.id,
      franchise: entry.data.franchise,
      year: entry.data.release.date ? String(entry.data.release.date.getUTCFullYear()) : '',
    });
  }
  bySaga.push({ saga: saga.id, entries });
}
const guide = await resolveProse('guides', language.code, 'where-to-start');

const year = (date: Date | null) => (date ? String(date.getUTCFullYear()) : '');

/* The heading is one sentence and word order differs between languages, so
   the title is placed by splitting the translated string at a placeholder
   rather than by concatenating fragments in English order. */
const SLOT = '@@';
const [beforeTitle, afterTitle] = t('home.startWith', { title: SLOT }).split(SLOT);

const tagline = site.tagline[language.code as keyof typeof site.tagline] ?? site.tagline.en;
---

<Base
  language={language.code}
  title={`${site.name}. ${tagline}`}
  description={t('home.firstRunLede')}
  editPath={`content/${language.code}/guides/where-to-start.md`}
>
  {first && (
    <section
      class="bleed band"
      data-livery
      style={liveryStyle(first.facts.data.saga, first.facts.data.franchise)}
    >
      <div class="page">
        <a class="plate" href={localePath(language.code, 'titles', first.facts.data.id)}>
          <h1 class="plate-title">
            {beforeTitle}<span class="plate-subject">{first.prose.entry.data.title}</span>{afterTitle}
          </h1>
          <p class="plate-meta">
            <span class="plate-set figure">{t('home.setNumber', { number: first.setNumber })}</span>
            <span class="figure">{year(first.facts.data.release.date)}</span>
            {first.facts.data.release.runtime && (
              <span class="figure">{t('title.runtime', { minutes: first.facts.data.release.runtime })}</span>
            )}
          </p>
        </a>
      </div>
    </section>
  )}

  {guide && (
    <div class="page reason">
      <p class="reason-text">{guide.entry.data.oneLine}</p>
      <a class="reason-link" href={localePath(language.code, 'guides', 'where-to-start')}>
        {t('home.readTheGuide')}
      </a>
    </div>
  )}

  <section class="section page">
    <div class="section-head">
      <h2>{t('home.runStart')}</h2>
      <p>{t('home.runStartLede')}</p>
    </div>

    <ol
      class="shelf"
      data-shelf
      data-label-mark={t('watched.mark')}
      data-label-unmark={t('watched.unmark')}
    >
      {run_start.map((item, index) => (
        <Spine
          language={language.code}
          id={item.facts.data.id}
          title={item.prose.entry.data.title}
          saga={item.facts.data.saga}
          franchise={item.facts.data.franchise}
          setNumber={item.setNumber}
          year={year(item.facts.data.release.date)}
          runtime={item.facts.data.release.runtime}
          href={localePath(language.code, 'titles', item.facts.data.id)}
          isNext={index === 0}
        />
      ))}
    </ol>

    <p class="onward">
      <a class="onward-link" href={localePath(language.code, 'timeline')}>
        {t('home.seeAll')}
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke-linecap="square" />
        </svg>
      </a>
    </p>

    <p class="storage-note">{t('watched.storageNotice')}</p>
  </section>

  <section class="section page">
    <div class="section-head">
      <h2>{t('home.allOf')}</h2>
      <p>{t('home.allOfLede')}</p>
    </div>

    <div class="saga-grid">
      {bySaga.map((block) => (
        <SagaBlock language={language.code} saga={block.saga} entries={block.entries} />
      ))}
    </div>
  </section>
</Base>
