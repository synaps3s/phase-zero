---
/*
 * The root path has no language of its own. Every language lives under its own
 * prefix so that none is treated as more canonical than another, so this page
 * exists only to send a visitor to one of them.
 *
 * It is also the first address a search engine tries, and the only page on the
 * site the layout does not build, so the head it needs has to be written here
 * by hand: an absolute canonical, because a relative one is read against the
 * page it sits on and says nothing a crawler can act on, and the same set of
 * alternates every other page carries.
 */
import { defaultLanguage, languages, localePath, useTranslations } from '../lib/i18n';
import site from '../../config/site.json';

const home = (code: string) => new URL(localePath(code), site.url).href;
const t = useTranslations(defaultLanguage.code);

/* This is the address people actually paste. It redirects, but a chat window
   or a social network reads the head it is given and never follows the
   redirect, so without these it shows a bare link or nothing at all. The
   source language answers for the site here, the same way x-default does. */
const title = `${site.name}. ${(site.tagline as Record<string, string>)[defaultLanguage.code]}`;
const description = t('home.description');
const card = new URL(`/social/${defaultLanguage.code}.png`, site.url).href;
---

<html lang={defaultLanguage.code}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${localePath(defaultLanguage.code)}`} />
    <link rel="canonical" href={home(defaultLanguage.code)} />
    {languages.map((language) => (
      <link rel="alternate" hreflang={language.code} href={home(language.code)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={home(defaultLanguage.code)} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={home(defaultLanguage.code)} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={card} />
  </head>
  <body>
    <p>Phase Zero is available in:</p>
    <ul>
      {languages.map((language) => (
        <li>
          <a href={localePath(language.code)} hreflang={language.code}>{language.endonym}</a>
        </li>
      ))}
    </ul>
  </body>
</html>
