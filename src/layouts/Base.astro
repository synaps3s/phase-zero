---
import '@fontsource-variable/jost';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/world.css';

import Starfield from '../components/Starfield.astro';
import Masthead from '../components/Masthead.astro';
import Colophon from '../components/Colophon.astro';
import {
  defaultLanguage,
  getLanguage,
  languages,
  localePath,
  useTranslations,
} from '../lib/i18n';
import site from '../../config/site.json';

interface Props {
  language: string;
  title: string;
  description: string;
  /** Path within the language, used by the language switcher and canonical. */
  path?: string;
  /** Repository path of the content file behind this page. */
  editPath?: string;
}

const { language: code, title, description, path = '', editPath } = Astro.props;
const language = getLanguage(code);
const t = useTranslations(language.code);

/* Used twice, as the canonical link and as the address a shared link resolves
   to, and they must not be able to disagree. */
const canonical = new URL(localePath(language.code, path), site.url).href;

/* The preview card, which a network fetches from outside the page and so has
   to be a full address rather than a path. */
const card = new URL(`/social/${language.code}.png`, site.url).href;

/* The taglines are keyed by language code in a JSON file, so the type read out
   of it lists the languages that exist today rather than any language code. */
const taglines: Record<string, string> = site.tagline;
const tagline = taglines[language.code] ?? taglines[languages[0].code];
---

<!doctype html>
<html lang={language.code} dir={language.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {languages.map((other) => (
      <link
        rel="alternate"
        hreflang={other.code}
        href={new URL(localePath(other.code, path), site.url).href}
      />
    ))}
    {/* What to show a reader whose language cannot be worked out. It points at
        the source language, which is the one guaranteed to be complete. */}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(defaultLanguage.code, path), site.url).href}
    />

    {/* How the page looks when somebody shares the link. The card is drawn by
        scripts/build-social-image.mjs from this project's own tokens and its own
        wordmark, one per language, which is the only kind of picture the rules
        here allow. og:locale is left out on purpose: it wants a territory, and
        this project has chosen a language without ever choosing a country to
        attach it to. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={`${site.name}. ${tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={card} />

    <script is:inline>
      /* The stored theme is applied before the first paint, so a reader who
         chose dark never sees a flash of the light stock. Inline and
         uncompiled on purpose: a module would arrive too late. */
      try {
        var stored = JSON.parse(window.localStorage.getItem('phasezero.v1') || '{}');
        if (stored.theme === 'light' || stored.theme === 'dark') {
          document.documentElement.setAttribute('data-theme', stored.theme);
        }
      } catch (error) {
        /* Storage is unavailable, so the system preference stands. */
      }
    </script>
  </head>

  <body>
    <Starfield />

    <a class="skip" href="#content">{t('site.skipToContent')}</a>

    <div class="page">
      <Masthead language={language.code} path={path} />
    </div>

    <main id="content">
      <slot />
    </main>

    <button type="button" class="to-top" data-to-top hidden aria-label={t('site.backToTop')}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 19V6M6 12l6-6 6 6" stroke-linecap="square" />
      </svg>
    </button>

    <Colophon language={language.code} editPath={editPath} />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
