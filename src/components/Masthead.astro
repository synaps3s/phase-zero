---
import { languages, localePath, useTranslations, getLanguage } from '../lib/i18n';

interface Props {
  language: string;
  /** Path within the language, so the switcher stays on the same page. */
  path?: string;
}

const { language, path = '' } = Astro.props;
const t = useTranslations(language);
const current = getLanguage(language);

/* Only routes that exist are listed. A menu pointing at pages nobody has
   built is worse than a short menu. */
const sections = [
  { key: 'nav.timeline', path: 'timeline' },
  { key: 'nav.characters', path: 'characters' },
  { key: 'nav.universes', path: 'universes' },
  { key: 'nav.phases', path: 'phases' },
  { key: 'nav.collections', path: 'collections' },
  { key: 'nav.glossary', path: 'glossary' },
  { key: 'nav.search', path: 'search' },
  { key: 'nav.guides', path: 'guides/where-to-start' },
];
---

<header class="masthead">
  <a class="wordmark" href={localePath(language)}>
    <span class="wordmark-mark" aria-hidden="true"></span>
    <span>Phase Zero</span>
  </a>

  <nav class="sections" aria-label={t('nav.sections')}>
    {sections.map((section) => (
      <a
        href={localePath(language, section.path)}
        aria-current={path === section.path || path.startsWith(`${section.path}/`) ? 'page' : undefined}
      >
        {t(section.key)}
      </a>
    ))}
  </nav>

  <div class="masthead-tools">
    {/* A list rather than a row of buttons, because this has to hold thirty
        languages as comfortably as it holds two. It is a disclosure element,
        so it opens and is reachable by keyboard with no JavaScript at all. */}
    <details class="picker" data-language-picker>
      <summary aria-label={t('nav.chooseLanguage')}>
        <span class="picker-current">{current.code}</span>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6l5 5 5-5" stroke-linecap="square" />
        </svg>
      </summary>
      <ul class="picker-list">
        {languages.map((other) => (
          <li>
            <a
              href={localePath(other.code, path)}
              hreflang={other.code}
              lang={other.code}
              aria-current={other.code === language ? 'true' : undefined}
            >
              <span class="picker-code">{other.code}</span>
              <span>{other.endonym}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>

    {/* One button that cycles. The label always names the state it is in, so
        a reader who cannot see the icon still knows which of the three is
        active. */}
    <button
      type="button"
      class="theme"
      data-theme-cycle
      data-label-light={t('theme.light')}
      data-label-dark={t('theme.dark')}
      data-label-system={t('theme.system')}
      data-announce={t('theme.cycle', { current: '{current}' })}
    >
      <svg class="theme-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle class="theme-sun" cx="10" cy="10" r="4" />
        <g class="theme-rays" stroke-linecap="round">
          <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M15.7 4.3l-1.4 1.4M5.7 14.3l-1.4 1.4" />
        </g>
        <path class="theme-moon" d="M13.5 11.5A5.5 5.5 0 0 1 8.5 6.5a5.5 5.5 0 1 0 5 5Z" />
        <path class="theme-auto" d="M10 3.5a6.5 6.5 0 0 0 0 13Z" fill="currentColor" stroke="none" />
      </svg>
      <span class="theme-label" data-theme-label>{t('theme.system')}</span>
    </button>
  </div>
</header>
