---
import { useTranslations } from '../lib/i18n';
import site from '../../config/site.json';

interface Props {
  language: string;
  /** Repository path of the file behind this page, for the edit link. */
  editPath?: string;
}

const { language, editPath } = Astro.props;
const t = useTranslations(language);
/* A page backed by one file links straight into an editor for it. A listing
   page is generated from a whole directory, so it links to the directory
   instead of pretending there is a single file to fix. */
const isDirectory = editPath?.endsWith('/') ?? false;
const editUrl = editPath
  ? `${site.repository}/${isDirectory ? 'tree' : 'edit'}/main/${editPath}`
  : null;
---

<footer class="colophon">
  <div class="page">
    <p>{t('footer.disclaimer')}</p>
    <p>{t('footer.license')}</p>
    <div class="colophon-row">
      <a href={site.repository}>{t('footer.sourceCode')}</a>
      {editUrl && (
        <a href={editUrl}>{t(isDirectory ? 'footer.editThisSection' : 'footer.editThisPage')}</a>
      )}
    </div>
  </div>
</footer>
