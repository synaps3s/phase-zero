---
import { SIGILS } from '../lib/sigils';
import { paletteFor } from '../lib/emblem-palettes';
import { liveryStyle } from '../lib/livery';

/*
 * A character's emblem.
 *
 * The sigil is authored artwork (sigils.ts) and the four colours around it
 * are chosen by hand (emblem-palettes.ts). Everything else is generated from
 * the character's own id: the dust, its positions, its opacities. The same
 * person always produces the same field, on every machine and in every
 * language.
 *
 * This is the project's entire answer to having no photographs, so it is
 * drawn at a real size and given light rather than being treated as an icon.
 * A character with no palette falls back to their franchise colour, which is
 * always defined, so nobody is left grey.
 */

interface Props {
  /** The character, which seeds the generated field. */
  id: string;
  /** Which authored glyph to draw. Falls back to the id. */
  sigil?: string | null;
  saga: string;
  franchise?: string;
  size?: number;
  /** Present makes the emblem an image with a name; absent makes it decoration. */
  label?: string;
}

const { id, sigil: sigilKey, saga, franchise, size = 96, label } = Astro.props;

const key = sigilKey ?? id;
const sigil = SIGILS[key];
const palette = paletteFor(key) ?? paletteFor(id);

/* Deterministic, so the field is a property of the character rather than of
   the moment the page was built. */
function seedOf(value: string): number {
  let hash = 2166136261;
  for (let index = 0; index < value.length; index += 1) {
    hash ^= value.charCodeAt(index);
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

let cursor = seedOf(id);
const next = () => {
  cursor = (cursor * 1664525 + 1013904223) >>> 0;
  return cursor / 4294967296;
};

const dust = Array.from({ length: 16 }, () => ({
  x: 2 + next() * 44,
  y: 2 + next() * 44,
  r: next() < 0.25 ? 0.9 : 0.5,
  o: 0.22 + next() * 0.55,
}));

/* With no authored glyph, a figure built from the same seed. Deliberately not
   a monogram: a letter in a box says the entry is unfinished, a mark does not. */
const seed = seedOf(id);
const spokes = Array.from({ length: 6 }, (unused, index) => {
  const angle = (index / 6) * Math.PI * 2 + (seed % 360) * (Math.PI / 180);
  const inner = 7 + ((seed >> (index * 3)) % 4);
  const outer = 14 + ((seed >> (index * 2)) % 5);
  return {
    x1: 24 + Math.cos(angle) * inner,
    y1: 24 + Math.sin(angle) * inner,
    x2: 24 + Math.cos(angle) * outer,
    y2: 24 + Math.sin(angle) * outer,
  };
});

const uid = `em-${key}`;
/* The shadowed side is named --emblem-shade and not --shade on purpose.
   liveryStyle sets --shade to a number, the step a franchise takes away from
   its saga colour, and --livery is a color-mix that multiplies it. Setting a
   colour on the same name here made that calculation invalid, which took
   --livery with it, and every character who falls back to it lost both the
   disc and the glyph: a black square with nothing on it. */
const style = [
  liveryStyle(saga, franchise),
  `--emblem-size: ${size}px`,
  palette
    ? `--face: ${palette[0]}; --emblem-shade: ${palette[1]}; --accent: ${palette[2]}; --glow: ${palette[3]}`
    : '--face: var(--livery); --emblem-shade: var(--void); --accent: var(--livery); --glow: var(--livery-glow)',
].join('; ');
---

<span class="emblem" data-livery style={style}>
  <span class="emblem-halo" aria-hidden="true"></span>

  <svg
    class="emblem-svg"
    viewBox="0 0 48 48"
    role={label ? 'img' : 'presentation'}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
  >
    <defs>
      <radialGradient id={`face-${uid}`} cx="34%" cy="28%" r="82%">
        <stop offset="0%" stop-color="var(--face)" />
        <stop offset="60%" stop-color="var(--emblem-shade)" />
        <stop offset="100%" stop-color="var(--void)" />
      </radialGradient>
      <radialGradient id={`core-${uid}`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.5" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect width="48" height="48" rx="14" fill={`url(#face-${uid})`} />
    <rect width="48" height="48" rx="14" fill={`url(#core-${uid})`} />

    <g class="emblem-dust" aria-hidden="true">
      {dust.map((mote) => <circle cx={mote.x} cy={mote.y} r={mote.r} opacity={mote.o} />)}
    </g>

    <circle class="emblem-rim" cx="24" cy="24" r="20.5" />
    <circle class="emblem-orbit" cx="24" cy="24" r="18" />

    {sigil ? (
      <g class="emblem-glyph" set:html={sigil} />
    ) : (
      <g class="emblem-glyph emblem-fallback">
        <circle cx="24" cy="24" r="4.2" />
        {spokes.map((spoke) => (
          <line x1={spoke.x1} y1={spoke.y1} x2={spoke.x2} y2={spoke.y2} />
        ))}
      </g>
    )}

    <rect class="emblem-edge" x="0.6" y="0.6" width="46.8" height="46.8" rx="13.6" />
  </svg>
</span>
