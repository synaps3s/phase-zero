---
import { SIGILS } from '../lib/sigils';
import { paletteFor } from '../lib/emblem-palettes';
import { liveryStyle } from '../lib/livery';

/*
 * A character's emblem.
 *
 * The sigil is authored artwork (sigils.ts) and the four colours around it
 * are chosen by hand (emblem-palettes.ts). Everything else is generated from
 * the character's own id: the dust, its positions, its opacities. The same
 * person always produces the same field, on every machine and in every
 * language.
 *
 * This is the project's entire answer to having no photographs, so it is
 * drawn at a real size and given light rather than being treated as an icon.
 * A character with no palette falls back to their franchise colour, which is
 * always defined, so nobody is left grey.
 */

interface Props {
  /** The character, which seeds the generated field. */
  id: string;
  /** Which authored glyph to draw. Falls back to the id. */
  sigil?: string | null;
  saga: string;
  franchise?: string;
  size?: number;
  /** Present makes the emblem an image with a name; absent makes it decoration. */
  label?: string;
}

const { id, sigil: sigilKey, saga, franchise, size = 96, label } = Astro.props;

const key = sigilKey ?? id;
const sigil = SIGILS[key];
const palette = paletteFor(key) ?? paletteFor(id);

/* Deterministic, so the field is a property of the character rather than of
   the moment the page was built. */
function seedOf(value: string): number {
  let hash = 2166136261;
  for (let index = 0; index < value.length; index += 1) {
    hash ^= value.charCodeAt(index);
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

let cursor = seedOf(id);
const next = () => {
  cursor = (cursor * 1664525 + 1013904223) >>> 0;
  return cursor / 4294967296;
};

const dust = Array.from({ length: 16 }, () => ({
  x: 2 + next() * 44,
  y: 2 + next() * 44,
  r: next() < 0.25 ? 0.9 : 0.5,
  o: 0.22 + next() * 0.55,
}));

/*
 * With no authored glyph, a mark built from the same seed. Deliberately not a
 * monogram: a letter in a box says the entry is unfinished, a mark does not.
 *
 * It draws from five families rather than one. A single family, however much
 * its angles and radii were varied, produced sixty marks that all read as the
 * same star, which is worse than no mark: it tells the reader these people are
 * interchangeable. Five shapes that are obviously different from each other at
 * 64 pixels, each picked and dimensioned by the character's own seed, do not.
 */
const CENTRE = 24;
let markCursor = seedOf(`${id}:mark`);
const roll = (): number => {
  markCursor = (markCursor * 1664525 + 1013904223) >>> 0;
  return markCursor / 4294967296;
};
/** An integer in [low, high], inclusive. */
const pick = (low: number, high: number) => low + Math.floor(roll() * (high - low + 1));

const family = pick(0, 4);
const turn = roll() * Math.PI * 2;
const at = (angle: number, radius: number) => ({
  x: CENTRE + Math.cos(angle) * radius,
  y: CENTRE + Math.sin(angle) * radius,
});

/* Rays out of a core. */
const rayCount = pick(5, 9);
const rayInner = 6 + pick(0, 3);
const rays = Array.from({ length: rayCount }, (unused, index) => {
  const angle = (index / rayCount) * Math.PI * 2 + turn;
  const outer = rayInner + 5 + pick(0, 4);
  const from = at(angle, rayInner);
  const to = at(angle, outer);
  return { x1: from.x, y1: from.y, x2: to.x, y2: to.y };
});

/* Orbits, with one body on the outermost. */
const ringCount = pick(2, 3);
const ringGap = pick(3, 5);
const rings = Array.from({ length: ringCount }, (unused, index) => 6 + index * ringGap);
const bodyAngle = roll() * Math.PI * 2;
const body = at(bodyAngle, rings[rings.length - 1]);

/* A regular polygon, held at an angle, with a mark on one corner. */
const sides = pick(3, 6);
const polygonRadius = 11 + pick(0, 3);
const corners = Array.from({ length: sides }, (unused, index) =>
  at((index / sides) * Math.PI * 2 + turn - Math.PI / 2, polygonRadius),
);
const polygon = corners.map((corner) => `${corner.x.toFixed(2)},${corner.y.toFixed(2)}`).join(' ');

/* Stacked bars, read like a signal rather than a figure. */
const barCount = pick(3, 5);
const barStep = 5;
const bars = Array.from({ length: barCount }, (unused, index) => {
  const width = pick(8, 19);
  return {
    x: CENTRE - width / 2,
    y: CENTRE - ((barCount - 1) * barStep) / 2 + index * barStep - 1.1,
    width,
    height: 2.2,
  };
});

/* Chords crossing off centre, with a node at each end. */
const chordCount = pick(2, 3);
const chords = Array.from({ length: chordCount }, (unused, index) => {
  const angle = turn + (index / chordCount) * Math.PI;
  const reach = 12 + pick(0, 3);
  const from = at(angle, reach);
  const to = at(angle + Math.PI, reach);
  return { x1: from.x, y1: from.y, x2: to.x, y2: to.y, from, to };
});

const uid = `em-${key}`;
/* The shadowed side is named --emblem-shade and not --shade on purpose.
   liveryStyle sets --shade to a number, the step a franchise takes away from
   its saga colour, and --livery is a color-mix that multiplies it. Setting a
   colour on the same name here made that calculation invalid, which took
   --livery with it, and every character who falls back to it lost both the
   disc and the glyph: a black square with nothing on it. */
const style = [
  liveryStyle(saga, franchise),
  `--emblem-size: ${size}px`,
  palette
    ? `--face: ${palette[0]}; --emblem-shade: ${palette[1]}; --accent: ${palette[2]}; --glow: ${palette[3]}`
    : '--face: var(--livery); --emblem-shade: var(--void); --accent: var(--livery); --glow: var(--livery-glow)',
].join('; ');
---

<span class="emblem" data-livery style={style}>
  <span class="emblem-halo" aria-hidden="true"></span>

  <svg
    class="emblem-svg"
    viewBox="0 0 48 48"
    role={label ? 'img' : 'presentation'}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
  >
    <defs>
      <radialGradient id={`face-${uid}`} cx="34%" cy="28%" r="82%">
        <stop offset="0%" stop-color="var(--face)" />
        <stop offset="60%" stop-color="var(--emblem-shade)" />
        <stop offset="100%" stop-color="var(--void)" />
      </radialGradient>
      <radialGradient id={`core-${uid}`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.5" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect width="48" height="48" rx="14" fill={`url(#face-${uid})`} />
    <rect width="48" height="48" rx="14" fill={`url(#core-${uid})`} />

    <g class="emblem-dust" aria-hidden="true">
      {dust.map((mote) => <circle cx={mote.x} cy={mote.y} r={mote.r} opacity={mote.o} />)}
    </g>

    <circle class="emblem-rim" cx="24" cy="24" r="20.5" />
    <circle class="emblem-orbit" cx="24" cy="24" r="18" />

    {sigil ? (
      <g class="emblem-glyph" set:html={sigil} />
    ) : (
      <g class="emblem-glyph emblem-fallback" data-family={family}>
        {family === 0 && (
          <>
            <circle cx="24" cy="24" r="4.2" />
            {rays.map((ray) => <line x1={ray.x1} y1={ray.y1} x2={ray.x2} y2={ray.y2} />)}
          </>
        )}
        {family === 1 && (
          <>
            {rings.map((radius) => <circle class="mark-ring" cx="24" cy="24" r={radius} />)}
            <circle cx={body.x} cy={body.y} r="2.6" />
          </>
        )}
        {family === 2 && (
          <>
            <polygon points={polygon} />
            <circle cx={corners[0].x} cy={corners[0].y} r="2.4" />
          </>
        )}
        {family === 3 && bars.map((bar) => (
          <rect x={bar.x} y={bar.y} width={bar.width} height={bar.height} rx="1.1" />
        ))}
        {family === 4 && (
          <>
            {chords.map((chord) => (
              <line x1={chord.x1} y1={chord.y1} x2={chord.x2} y2={chord.y2} />
            ))}
            {chords.map((chord) => (
              <>
                <circle cx={chord.from.x} cy={chord.from.y} r="1.8" />
                <circle cx={chord.to.x} cy={chord.to.y} r="1.8" />
              </>
            ))}
          </>
        )}
      </g>
    )}

    <rect class="emblem-edge" x="0.6" y="0.6" width="46.8" height="46.8" rx="13.6" />
  </svg>
</span>
