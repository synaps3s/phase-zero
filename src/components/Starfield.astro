---
/*
 * The void's particle field.
 *
 * A light canvas fixed behind everything. It is decoration and knows it:
 * hidden from assistive technology, never blocking a pointer, drawn once
 * and left still when the reader asks for reduced motion, and paused
 * outright when the tab is not visible so it costs nothing in the
 * background.
 */
---

<canvas id="starfield" aria-hidden="true"></canvas>

<style>
  #starfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  interface Particle {
    x: number;
    y: number;
    depth: number;
    radius: number;
    alpha: number;
    phase: number;
    colour: string;
  }

  const canvas = document.getElementById('starfield') as HTMLCanvasElement | null;
  const context = canvas?.getContext('2d');

  if (canvas && context) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let particles: Particle[] = [];
    let width = 0;
    let height = 0;
    let frame = 0;

    /* The field takes its warm specks from whatever the page's current
       state colour is, so it belongs to the theme instead of fighting it. */
    const stateColour = () =>
      getComputedStyle(document.documentElement).getPropertyValue('--watched').trim() || '#ffc47a';

    const inkColour = () =>
      getComputedStyle(document.documentElement).getPropertyValue('--core').trim() || '#ffffff';

    function build(): void {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas!.width = Math.floor(width * ratio);
      canvas!.height = Math.floor(height * ratio);
      context!.setTransform(ratio, 0, 0, ratio, 0, 0);

      const count = Math.min(190, Math.floor((width * height) / 8600));
      const warm = stateColour();
      const cool = inkColour();

      particles = Array.from({ length: count }, () => {
        const depth = Math.random();
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          depth,
          radius: depth * 1.4 + 0.25,
          alpha: 0.14 + Math.random() * 0.62,
          phase: Math.random() * Math.PI * 2,
          colour: Math.random() < 0.12 ? warm : cool,
        };
      });
    }

    function draw(time: number): void {
      context!.clearRect(0, 0, width, height);
      const still = reduced.matches;

      for (const particle of particles) {
        if (!still) {
          // Nearer particles drift faster, which is the whole illusion.
          particle.y += particle.depth * 0.12 + 0.02;
          if (particle.y > height + 2) {
            particle.y = -2;
            particle.x = Math.random() * width;
          }
        }
        const twinkle = still ? 1 : 0.62 + 0.38 * Math.sin(time * 0.0011 + particle.phase);
        context!.globalAlpha = particle.alpha * twinkle;
        context!.fillStyle = particle.colour;
        context!.beginPath();
        context!.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
        context!.fill();
      }

      context!.globalAlpha = 1;
      if (!still) frame = requestAnimationFrame(draw);
    }

    function restart(): void {
      cancelAnimationFrame(frame);
      build();
      if (reduced.matches) draw(0);
      else frame = requestAnimationFrame(draw);
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(restart, 180);
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(frame);
      else if (!reduced.matches) frame = requestAnimationFrame(draw);
    });

    reduced.addEventListener('change', restart);
    // The field is rebuilt when the theme changes so its specks stay in
    // the palette rather than becoming the last theme's leftovers.
    document.addEventListener('themechange', restart);

    restart();
  }
</script>
