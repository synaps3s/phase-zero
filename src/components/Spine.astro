---
import { liveryStyle, franchiseName } from '../lib/livery';
import { useTranslations } from '../lib/i18n';

interface Props {
  language: string;
  id: string;
  title: string;
  saga: string;
  franchise: string;
  setNumber: number;
  year: string;
  runtime: number | null;
  href: string;
  /* Rendered by the server so the call-out is right with no JavaScript.
     The script re-derives it as titles are marked. */
  isNext?: boolean;
  /* Present only on the timeline, where rows are reordered and filtered in
     the browser. Sorting sets the flex order rather than moving nodes, so
     the document order stays the one the server sent. */
  releaseOrder?: number;
  chronoOrder?: number;
  /** Whether that position came from a source, or was merely inherited. */
  placedInStory?: boolean;
  tierRank?: number;
  /* film, series, special or short. The row says which, because "54 min" on a
     thirteen episode series and "54 min" on a film mean very different things
     to somebody deciding what to watch tonight. */
  kind?: string;
  episodes?: number | null;
  continuity?: string;
  /* Shown only for an entry of this run whose story is set somewhere other
     than the universe the run otherwise takes place in. */
  universeLabel?: string | null;
  /* Announced but not out. The row still appears, because knowing what is
     coming is part of what a catalogue is for, but it carries no runtime,
     no watch control and no weight in the hours left to watch. */
  unreleased?: boolean;
  searchText?: string;
  setting?: string | null;
}

const {
  language,
  id,
  title,
  saga,
  franchise,
  setNumber,
  year,
  runtime,
  href,
  isNext = false,
  releaseOrder,
  chronoOrder,
  placedInStory = true,
  tierRank,
  kind,
  episodes = null,
  continuity,
  universeLabel = null,
  unreleased = false,
  searchText,
  setting,
} = Astro.props;
const t = useTranslations(language);

/* How long the whole entry takes. A series runtime is per episode, so a
   thirteen part season is thirteen times it. The hours left to watch were
   wrong by an order of magnitude while this was the per-episode figure. */
const totalMinutes = unreleased ? 0 : (runtime ?? 0) * (episodes ?? 1);
---

<li
  class="spine"
  data-livery
  data-title-id={id}
  data-saga={saga}
  data-watched="false"
  data-next={String(isNext)}
  data-release={releaseOrder}
  data-chrono={chronoOrder}
  data-placed={String(placedInStory)}
  data-tier={tierRank}
  data-kind={kind}
  data-continuity={continuity}
  data-unreleased={String(unreleased)}
  data-minutes={totalMinutes}
  data-search={searchText}
  style={liveryStyle(saga, franchise)}
>
  <span class="spine-set figure" aria-hidden="true">{setNumber}</span>

  <div class="spine-body">
    <h3 class="spine-title">
      <a href={href}>{title}</a>
      <span class="spine-next-label">{t('title.next')}</span>
    </h3>
    <p class="spine-meta">
      {!placedInStory && <span class="spine-unplaced">{t('watchOrder.unplaced')}</span>}
      <span class="figure">{year}</span>
      {unreleased && <span class="spine-upcoming">{t('title.upcoming')}</span>}
      {kind && <span class="spine-kind">{t(`title.kind.${kind}`)}</span>}
      {episodes && <span class="figure">{t('title.episodes', { count: episodes })}</span>}
      {runtime && (
        <span class="figure">
          {t(episodes ? 'title.runtimeEach' : 'title.runtime', { minutes: runtime })}
        </span>
      )}
      <span class="spine-franchise">{franchiseName(franchise)}</span>
      {universeLabel && <span class="spine-elsewhere figure">{universeLabel}</span>}
      {setting && <span class="spine-setting figure">{setting}</span>}
    </p>
  </div>

  {!unreleased && (
    <button
      type="button"
      class="spine-mark"
      data-watch-toggle
      aria-pressed="false"
      aria-label={t('watched.mark')}
    >
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M4 10.5 8 14.5 16 5.5" stroke-linecap="square" />
      </svg>
    </button>
  )}
</li>
