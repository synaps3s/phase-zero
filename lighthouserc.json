{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "/en.html",
        "/en/timeline.html",
        "/en/characters.html",
        "/en/characters/logan.html",
        "/it/timeline.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "color-contrast": "error",
        "html-has-lang": "error",
        "html-lang-valid": "error",
        "hreflang": "error",
        "document-title": "error",
        "meta-description": "error",
        "heading-order": "error",
        "link-name": "error",
        "button-name": "error",
        "image-alt": "error",
        "errors-in-console": "error",
        "uses-http2": "off",
        "redirects-http": "off",
        "is-on-https": "off",
        "csp-xss": "off",
        "uses-long-cache-ttl": "off",
        "unused-javascript": "off",
        "unsized-images": "off",
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 400000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
